{
  "name": "visual-roadmap",
  "version": "0.5.1",
  "description": "Live roadmap for vibecoding: your coding agent keeps ROADMAP.md current with one-line commands and you watch progress, ETAs and problems in the browser.",
  "author": "DesvoSoft",
  "license": "MIT",
  "keywords": [
    "roadmap",
    "ai-agents",
    "vibecoding",
    "claude-code",
    "codex",
    "cursor",
    "progress-tracker",
    "gantt",
    "markdown",
    "cli",
    "devtools"
  ],
  "bin": {
    "visual-roadmap": "./bin/visual-roadmap.js"
  },
  "main": "./lib/agent.js",
  "files": [
    "bin/",
    "lib/",
    "dist/",
    "viewer/",
    "templates/",
    "docs/ROADMAP_FORMAT.md",
    "docs/DEVELOPMENT.md",
    "examples/",
    "SKILL.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "start": "node bin/visual-roadmap.js serve --file examples/VOIDFRONT.md",
    "test": "node --test",
    "demo": "node scripts/simulate.js",
    "screenshots": "node scripts/screenshots.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DesvoSoft/visual-roadmap.git"
  },
  "bugs": {
    "url": "https://github.com/DesvoSoft/visual-roadmap/issues"
  },
  "homepage": "https://github.com/DesvoSoft/visual-roadmap#readme"
}
